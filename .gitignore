# Ignore all JSON by default — the next token cache, export, or credential file
# gets caught automatically instead of relying on someone remembering to add it.
# Config that must ship is re-admitted explicitly below.
*.json
!config.json

# Generated locally. Describes YOUR installed tools, which means it names your
# private skills — the sharpest leak vector in this repo.
descriptions.json

# One-off and scratch scripts, which is where real data ends up.
apply_*.py
scratch_*.py
*_local.py

# Internal planning docs. They name private skills and personal paths, so they
# are excluded from the public repo. Remove these lines only if you decide
# the requirements history should ship — read them first.
TODO.md
PRD.md
promo-drafts.md

# Screenshots — any capture of a real dashboard shows real installed skills.
# docs/ is the exception: those are curated, filtered to third-party skills
# only, and reviewed before committing.
*.png
*.jpg
*.jpeg
!docs/*.png
# assets/bg-float.jpg — the floating map-and-magnifying-glass background.
# Unsplash photo by Angelo Casto (unsplash.com/photos/OKJHAjc7wz0), used
# under the Unsplash License: free for commercial and noncommercial use,
# no permission or attribution required. Safe to ship as-is.
!assets/bg-float.jpg

__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# playwright-cli's own local session snapshots — verification tooling
# artifacts, not part of the app.
.playwright-cli/
